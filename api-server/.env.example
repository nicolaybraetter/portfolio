# DJ Except4 API Server Environment
# Copy to .env and fill in your values

# IONOS SMTP Credentials (for sending emails)
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=info@djexcept4.de
SMTP_PASS=your-ionos-smtp-password-here

# Contact form recipient
CONTACT_EMAIL=info@djexcept4.de

# Admin Panel Password
ADMIN_PASSWORD=your-admin-password-here

# Admin Session Secret (change to a random string)
ADMIN_SESSION_SECRET=change-me-in-production

# API Server Port
API_PORT=3001