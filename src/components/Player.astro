---
interface Props {
  trackId: string;
  coverUrl: string;
  title: string;
  autoPlay?: boolean;
}

const { trackId, coverUrl, title, autoPlay = false } = Astro.props;
---

<div class="player-container" id={`player-${trackId}`} role="region" aria-label={`Audio-Player: ${title}`}>
  <div class="player-wrapper">
    <!-- Cover Art -->
    <div class="player-cover">
      <img
        src={coverUrl}
        alt={`Cover von ${title}`}
        width="200"
        height="200"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Track Info -->
    <div class="player-info">
      <h3 class="player-title">{title}</h3>
      <p class="player-artist">DJ Except4</p>
    </div>

    <!-- Waveform (decorative) -->
    <div class="player-waveform" id={`waveform-${trackId}`} aria-hidden="true"></div>
  </div>
</div>

<style>
  .player-container {{
    background: var(--dj-surface);
    border: 1px solid var(--dj-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    max-width: 600px;
    margin: 0 auto;
  }}

  .player-wrapper {{
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }}

  .player-cover img {
    width: 100%;
    max-width: 200px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin: 0 auto;
  }

  .player-info {
    text-align: center;
  }

  .player-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 var(--space-xs);
  }

  .player-artist {
    color: var(--dj-text-secondary);
    font-size: 0.9rem;
    margin: 0;
  }

  .player-waveform {
    width: 100%;
    height: 60px;
    background: var(--dj-bg-primary);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .player-container {
      padding: var(--space-md);
    }
  }
</style>