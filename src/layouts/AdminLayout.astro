---
// Admin Layout — shared shell for all admin pages
// Uses the same design system as the homepage (global.css)
import '../styles/global.css';

const { title } = Astro.props;
const locale = Astro.currentLocale || 'de';
const isEn = locale === 'en';
---

<!doctype html>
<html lang={isEn ? 'en' : 'de'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — DJ Except4 Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="admin-body" data-locale={isEn ? 'en' : 'de'}>
    <div id="admin-auth-check">
      <p>Prüfe Authentifizierung...</p>
    </div>
    <script>
      // Auth check on page load
      const locale = document.body.dataset.locale || 'de';
      fetch('/api/admin/verify', { credentials: 'same-origin' })
        .then(r => {
          if (r.ok) {
            document.getElementById('admin-auth-check').style.display = 'none';
            document.querySelector('.admin-layout').style.display = 'flex';
          } else {
            window.location.href = '/' + locale + '/admin/login/';
          }
        })
        .catch(() => {
          window.location.href = '/' + locale + '/admin/login/';
        });

      // Logout handler
      const logoutBtn = document.getElementById('admin-logout-btn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async (e) => {
          e.preventDefault();
          try {
            await fetch('/api/admin/logout', {
              method: 'POST',
              credentials: 'same-origin',
            });
          } catch (_) {
            // Ignore network errors — proceed to login page anyway
          }
          window.location.href = '/' + locale + '/admin/login/';
        });
      }
    </script>
    <div class="admin-layout" style="display:none">
      <aside class="admin-sidebar" role="navigation" aria-label="Admin navigation">
        <div class="admin-logo">
          <img src="/assets/DJ_Except4-Logo-120.webp" alt="DJ Except4" width="60" height="60" />
          <span>Admin</span>
        </div>
        <nav>
          <ul>
            <li><a href={`/${locale}/admin/`}>{isEn ? 'Dashboard' : 'Übersicht'}</a></li>
            <li><a href={`/${locale}/admin/werbung/`}>{isEn ? 'Advertising' : 'Werbung'}</a></li>
            <li><a href={`/${locale}/admin/medien/`}>{isEn ? 'Media' : 'Medien'}</a></li>
            <li><a href={`/${locale}/admin/streaming/`}>{isEn ? 'Streaming' : 'Streaming'}</a></li>
            <li><a href={`/${locale}/admin/seo/`}>{isEn ? 'SEO' : 'SEO'}</a></li>
            <li><a href={`/${locale}/admin/email/`}>{isEn ? 'Email' : 'E-Mail'}</a></li>
          </ul>
        </nav>
        <div class="admin-logout">
          <a href={`/${locale}/admin/login/`} id="admin-logout-btn" role="button">{isEn ? 'Logout' : 'Abmelden'}</a>
        </div>
      </aside>
      <main class="admin-main" role="main">
        <slot />
      </main>
    </div>
  </body>
</html>