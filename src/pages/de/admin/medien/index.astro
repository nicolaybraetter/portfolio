---
import Layout from '../../layouts/AdminLayout.astro';
import content from '../../../data/content.json';

const locale = Astro.currentLocale || 'de';
const isEn = locale === 'en';
---

<Layout title={isEn ? 'Admin — Media' : 'Admin — Medien'}>
  <h1>{isEn ? 'Media Library' : 'Mediathek'}</h1>

  <div class="admin-section">
    <div class="media-toolbar">
      <button class="btn-add" id="btn-upload">
        {isEn ? '+ Upload Media' : '+ Medien hochladen'}
      </button>
      <input type="file" id="media-upload" multiple accept="image/*" style="display:none" />
    </div>

    <div class="media-grid" id="media-grid">
      {/* Media items will be populated by JavaScript */}
      <p class="media-empty">{isEn ? 'No media files uploaded yet.' : 'Noch keine Mediendateien hochgeladen.'}</p>
    </div>
  </div>

  <!-- Upload Modal -->
  <div class="upload-modal" id="upload-modal" style="display:none;">
    <div class="modal-content">
      <h3>{isEn ? 'Upload Media' : 'Medien hochladen'}</h3>
      <p>{isEn ? 'Drag & drop files or click to select' : 'Dateien per Drag & Drop ablegen oder klicken zum Auswählen'}</p>
      <input type="file" id="file-input" multiple accept="image/png,image/jpeg,image/webp,image/svg" />
      <div class="upload-preview" id="upload-preview"></div>
      <div class="form-actions">
        <button type="button" class="button button-primary" id="btn-do-upload">
          {isEn ? 'Upload' : 'Hochladen'}
        </button>
        <button type="button" class="button button-secondary" id="btn-cancel-upload">
          {isEn ? 'Cancel' : 'Abbrechen'}
        </button>
      </div>
    </div>
  </div>
</Layout>

<script define:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btnUpload = document.getElementById('btn-upload');
    const fileInput = document.getElementById('file-input');
    const modal = document.getElementById('upload-modal');
    const btnCancel = document.getElementById('btn-cancel-upload');
    const btnDoUpload = document.getElementById('btn-do-upload');
    const preview = document.getElementById('upload-preview');
    const grid = document.getElementById('media-grid');

    if (btnUpload && modal) {
      btnUpload.addEventListener('click', () => {
        modal.style.display = modal.style.display === 'none' ? 'flex' : 'none';
      });
    }

    if (btnCancel && modal) {
      btnCancel.addEventListener('click', () => {
        modal.style.display = 'none';
      });
    }

    // Preview selected files
    if (fileInput && preview) {
      fileInput.addEventListener('change', () => {
        preview.innerHTML = '';
        Array.from(fileInput.files).forEach((file) => {
          const div = document.createElement('div');
          div.className = 'upload-item';
          div.textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
          preview.appendChild(div);
        });
      });
    }

    // Simulate upload
    if (btnDoUpload && modal && grid) {
      btnDoUpload.addEventListener('click', () => {
        alert('Upload functionality requires a backend. Files would be stored in /public/media/');
        modal.style.display = 'none';
      });
    }
  });
</script>

<style>
  .admin-section {
    padding: var(--space-xl);
    background: var(--dj-surface);
    border: 1px solid var(--dj-border);
    border-radius: var(--radius-lg);
  }

  .media-toolbar {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-md);
  }

  .media-empty {
    color: var(--dj-text-muted);
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--space-2xl);
  }

  .upload-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .modal-content {
    background: var(--dj-surface);
    border: 1px solid var(--dj-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    max-width: 500px;
    width: 90%;
  }

  .upload-item {
    padding: var(--space-sm);
    background: var(--dj-bg-primary);
    border: 1px solid var(--dj-border);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    word-break: break-all;
  }

  .form-actions {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  h1 { margin-bottom: var(--space-xl); }
  h3 { margin-bottom: var(--space-md); }
</style>