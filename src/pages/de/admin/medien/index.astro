---
import Layout from '../../../../layouts/AdminLayout.astro';
import content from '../../../../data/content.json';

const locale = Astro.currentLocale || 'de';
const isEn = locale === 'en';
---

<Layout title={isEn ? 'Admin — Media' : 'Admin — Medien'}>
  <section class="section" aria-labelledby="admin-heading">
    <div class="container">
      <h1 id="admin-heading">{isEn ? 'Media Library' : 'Mediathek'}</h1>

      <div class="admin-section">
        <div class="media-toolbar">
      <button class="btn btn-primary" id="btn-upload">
        {isEn ? '+ Upload Media' : '+ Medien hochladen'}
      </button>
      <input type="file" id="media-upload" multiple accept="image/*" class="hidden" />
    </div>

    <div class="media-grid" id="media-grid">
      <p class="media-empty">{isEn ? 'No media files uploaded yet.' : 'Noch keine Mediendateien hochgeladen.'}</p>
    </div>
  </div>

  <!-- Upload Modal -->
  <div class="upload-modal" id="upload-modal" class="hidden">
    <div class="modal-content">
      <h3>{isEn ? 'Upload Media' : 'Medien hochladen'}</h3>
      <p>{isEn ? 'Drag & drop files or click to select' : 'Dateien per Drag & Drop ablegen oder klicken zum Auswählen'}</p>
      <input type="file" id="file-input" multiple accept="image/png,image/jpeg,image/webp,image/svg" />
      <div class="upload-preview" id="upload-preview"></div>
      <div class="form-actions">
        <button type="button" class="btn btn-primary" id="btn-do-upload">
          {isEn ? 'Upload' : 'Hochladen'}
        </button>
        <button type="button" class="btn btn-secondary" id="btn-cancel-upload">
          {isEn ? 'Cancel' : 'Abbrechen'}
        </button>
      </div>
    </div>
  </div>
    </div>
  </section>
</Layout>

<script define:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btnUpload = document.getElementById('btn-upload');
    const fileInput = document.getElementById('file-input');
    const modal = document.getElementById('upload-modal');
    const btnCancel = document.getElementById('btn-cancel-upload');
    const btnDoUpload = document.getElementById('btn-do-upload');
    const preview = document.getElementById('upload-preview');
    const grid = document.getElementById('media-grid');

    if (btnUpload && modal) {
      btnUpload.addEventListener('click', () => {
        modal.style.display = modal.style.display === 'none' ? 'flex' : 'none';
      });
    }

    if (btnCancel && modal) {
      btnCancel.addEventListener('click', () => {
        modal.style.display = 'none';
      });
    }

    // Preview selected files
    if (fileInput && preview) {
      fileInput.addEventListener('change', () => {
        preview.innerHTML = '';
        Array.from(fileInput.files).forEach((file) => {
          const div = document.createElement('div');
          div.className = 'upload-item';
          div.textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
          preview.appendChild(div);
        });
      });
    }

    // Simulate upload
    if (btnDoUpload && modal && grid) {
      btnDoUpload.addEventListener('click', () => {
        alert('Upload functionality requires a backend. Files would be stored in /public/media/');
        modal.style.display = 'none';
      });
    }
  });
</script>