---
import Layout from '../../../layouts/Layout.astro';

const locale = Astro.currentLocale || 'de';
const isEn = locale === 'en';
---

<Layout
  title={isEn ? 'Admin Login — DJ Except4' : 'Admin Login — DJ Except4'}
  description={isEn ? 'Sign in to manage your site.' : 'Melde dich an, um deine Seite zu verwalten.'}
  image={`/assets/DJ_Except4-Logo-120.webp`}
  type="website"
  locale={locale}
>
  <section class="login-page" aria-labelledby="login-heading">
    <div class="login-container">
      <div class="login-card">
        <div class="login-header">
          <img src="/assets/DJ_Except4-Logo-120.webp" alt="DJ Except4" width="60" height="60" loading="eager" />
          <h1 id="login-heading">{isEn ? 'Admin Login' : 'Admin Login'}</h1>
          <p>{isEn ? 'Sign in to manage your site' : 'Melde dich an, um deine Seite zu verwalten'}</p>
        </div>
        <form id="login-form" class="login-form" novalidate>
          <div class="form-group">
            <label for="password">{isEn ? 'Password' : 'Passwort'}</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder={isEn ? 'Enter password' : 'Passwort eingeben'}
            />
          </div>
          <div id="login-error" class="login-error" style="display:none" role="alert"></div>
          <button type="submit" class="button button-primary button-full" id="login-submit">
            {isEn ? 'Sign In' : 'Anmelden'}
          </button>
        </form>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('login-form');
      const submitBtn = document.getElementById('login-submit');
      const errorDiv = document.getElementById('login-error');
      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!submitBtn || !errorDiv) return;

        const password = (document.getElementById('password') as HTMLInputElement)?.value || '';

        submitBtn.disabled = true;
        submitBtn.textContent = 'Wird geprüft...';
        errorDiv.style.display = 'none';
        errorDiv.textContent = '';

        try {
          const response = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password }),
            credentials: 'same-origin',
          });

          const data = await response.json();

          if (response.ok && data.success) {
            window.location.href = '/' + (document.documentElement.lang === 'en' ? 'en' : 'de') + '/admin/';
          } else {
            errorDiv.textContent = data.error || 'Ungültiges Passwort.';
            errorDiv.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Anmelden';
          }
        } catch (err) {
          errorDiv.textContent = 'Verbindungsfehler. Bitte versuche es erneut.';
          errorDiv.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Anmelden';
        }
      });
    });
  </script>
</Layout>

<style>
  .login-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: var(--space-xl);
    background: var(--dj-bg-primary, #0a0a14);
  }

  .login-card {
    width: 100%;
    max-width: 400px;
    background: var(--dj-surface, #14142a);
    border: 1px solid var(--dj-border, #2a2a4a);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    box-shadow: var(--shadow-xl);
  }

  .login-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .login-header img {
    margin-bottom: var(--space-md);
    border-radius: 50%;
    border: 2px solid var(--dj-accent-cyan);
  }

  .login-header h1 {
    margin: 0 0 var(--space-sm);
    font-size: 1.5rem;
  }

  .login-header p {
    margin: 0;
    color: var(--dj-text-secondary);
    font-size: 0.9rem;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .form-group label {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--dj-text-secondary);
  }

  .form-group input {
    padding: 0.75rem 1rem;
    background: var(--dj-bg-primary, #0a0a14);
    border: 1px solid var(--dj-border, #2a2a4a);
    border-radius: var(--radius-sm);
    color: var(--dj-text-primary, #e8e8f0);
    font-size: 1rem;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .form-group input:focus {
    border-color: var(--dj-accent-cyan);
  }

  .login-error {
    padding: var(--space-md);
    background: rgba(248, 113, 113, 0.1);
    border: 1px solid var(--dj-error, #f87171);
    border-radius: var(--radius-sm);
    color: var(--dj-error, #f87171);
    font-size: 0.85rem;
  }

  .button-full {
    width: 100%;
  }
</style>