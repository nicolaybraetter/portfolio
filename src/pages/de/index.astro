---
import Layout from '../../layouts/Layout.astro';
import content from '../../data/content.json';

const locale = Astro.currentLocale || 'de';
const isEn = locale === 'en';
const basePath = isEn ? 'en/' : 'de/';
const tracks = content.tracks || [];
const latestTrack = tracks[0];
const socialLinks = content.social || {};
const ads = content.ads || [];
const faqs = content.faq || [];
const youtube = content.youtube || {};
---

<Layout
  title={isEn ? 'DJ Except4 — Electronic Music Producer' : 'DJ Except4 — Electronic Music Producer'}
  description={isEn ? 'DJ & Producer from Germany. Uplifting Trance, Vocal Trance and Emotional Electronic Music. Listen, follow, and stay connected.' : 'DJ & Producer aus Deutschland. Uplifting Trance, Vocal Trance und emotionales Electronic Music. Hören, folgen und vernetzen.'}
  image={`/assets/DJ_Except4-Logo-1200.webp`}
  type="website"
  locale={locale}
>

  <!-- ── Hero ── -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-overlay"></div>
    <div class="hero-logo-bg" aria-hidden="true">
      <img src="/assets/DJ_Except4-Logo-1200.webp" alt="" width="600" height="600" loading="eager" />
    </div>
    <div class="hero-content container">
      <p class="eyebrow">{isEn ? 'Welcome to my world' : 'Willkommen in meiner Welt'}</p>
      <h1 id="hero-heading">DJ Except4</h1>
      <p class="hero-subtitle">
        {isEn
          ? 'Uplifting Trance · Vocal Trance · Emotional Electronic Music'
          : 'Uplifting Trance · Vocal Trance · Emotionales Electronic Music'}
      </p>
      <div class="hero-actions">
        <a href={`/${basePath}tracks/`} class="btn btn-primary">
          {isEn ? 'Listen to Music' : 'Musik hören'}
        </a>
        <a href={`/${basePath}contact/`} class="btn btn-secondary">
          {isEn ? 'Get in Touch' : 'Kontakt aufnehmen'}
        </a>
      </div>
    </div>
  </section>

  <!-- ── Latest Track ── -->
  {latestTrack && (
    <section class="section" aria-labelledby="latest-heading">
      <div class="container">
        <div class="section-header">
          <h2 id="latest-heading">{isEn ? 'Latest Release' : 'Neueste Veröffentlichung'}</h2>
          <a href={`/${basePath}tracks/`} class="btn btn-ghost">
            {isEn ? 'All Tracks →' : 'Alle Tracks →'}
          </a>
        </div>
        <div class="track-hero-card card">
          <div class="track-hero-cover">
            <img
              src={latestTrack.files?.cover || '/assets/DJ_Except4-Logo-1200.webp'}
              alt={`${latestTrack.title} Cover`}
              width="400"
              height="400"
              loading="eager"
            />
            <div class="track-hero-overlay">
              <a href={latestTrack.files?.mp4 || latestTrack.youtube?.url || '#'} class="play-button" aria-label={isEn ? 'Play' : 'Abspielen'}>
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <circle cx="24" cy="24" r="23" stroke="white" stroke-width="2" fill="none"/>
                  <path d="M19 16L34 24L19 32V16Z" fill="white"/>
                </svg>
              </a>
            </div>
          </div>
          <div class="track-hero-info">
            <p class="eyebrow">{latestTrack.title}</p>
            <h3>{latestTrack.title}</h3>
            <p class="track-meta">
              {latestTrack.bpm} BPM · {latestTrack.key} · {latestTrack.releaseDate || ''}
            </p>
            <p class="track-description">{latestTrack.description}</p>
            <div class="track-actions">
              {latestTrack.youtube?.url && (
                <a href={latestTrack.youtube.url} class="btn btn-secondary" target="_blank" rel="noopener">
                  {isEn ? 'Watch on YouTube' : 'Auf YouTube ansehen'}
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ── YouTube Showcase ── -->
  <section class="section section-sm" aria-labelledby="youtube-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="youtube-heading">{isEn ? 'YouTube' : 'YouTube'}</h2>
        <a href="https://www.youtube.com/@DJExcept4" target="_blank" rel="noopener" class="btn btn-ghost">
          {isEn ? 'Subscribe →' : 'Abonnieren →'}
        </a>
      </div>
      <div class="grid-cards youtube-grid">
        {tracks.map((track) => (
          <a href={track.youtube?.url || '#'} target="_blank" rel="noopener" class="youtube-card card">
            <div class="youtube-thumb">
              <img
                src={track.files?.cover || '/media/youtube/thumb-' + track.id + '-maxres.jpg'}
                alt={track.title + ' YouTube thumbnail'}
                width="400"
                height="225"
                loading="lazy"
              />
              <div class="youtube-play">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                  <circle cx="20" cy="20" r="19" fill="rgba(0,0,0,0.6)" stroke="white" stroke-width="2"/>
                  <path d="M15 14L28 20L15 26V14Z" fill="white"/>
                </svg>
              </div>
            </div>
            <div class="youtube-card-info">
              <h3>{track.title}</h3>
              <p class="track-meta">{track.bpm} BPM · {track.key}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── DistroKid Promotion ── -->
  {ads.length > 0 && ads[0] && (
    <section class="section section-sm" aria-labelledby="ad-heading">
      <div class="container">
        <div class="promo-card card">
          <div class="promo-content">
            <h3>{ads[0].title}</h3>
            <p>{ads[0].description}</p>
            <a href={ads[0].url} class="btn btn-primary" target="_blank" rel="noopener">
              {isEn ? 'Learn More' : 'Mehr erfahren'}
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ── Music Platforms ── -->
  <section class="section section-sm" aria-labelledby="platforms-heading">
    <div class="container">
      <h2 id="platforms-heading" class="section-title">{isEn ? 'Available on' : 'Verfügbar auf'}</h2>
      <div class="platform-logos">
              <a href="https://open.spotify.com/artist/djexcept4" target="_blank" rel="noopener" class="platform-logo" aria-label="Spotify">
                <svg viewBox="0 0 24 24" width="56" height="56" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.18-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
              </a>
              <a href="https://music.youtube.com/channel/UC74F7b6EKNZczMq-saELxWQ" target="_blank" rel="noopener" class="platform-logo" aria-label="YouTube Music">
                <svg viewBox="0 0 24 24" width="56" height="56" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
              <a href="https://www.amazon.com/music/player/artists/djexcept4" target="_blank" rel="noopener" class="platform-logo" aria-label="Amazon Music">
                <svg viewBox="0 0 24 24" width="56" height="56" fill="currentColor"><path d="M.045 18.02c.072-.116.187-.124.348-.022 3.636 2.11 7.594 3.166 11.87 3.166 2.852 0 5.668-.533 8.447-1.595l.315-.14c.138-.06.234-.1.293-.13.226-.088.39-.046.525.13.12.174.09.336-.12.48-.256.19-.6.41-1.006.654-1.244.743-2.64 1.316-4.185 1.726a17.617 17.617 0 01-10.951-.577 17.88 17.88 0 01-5.43-3.35c-.1-.074-.151-.15-.151-.22 0-.047.021-.09.051-.13zm6.565-6.218c0-1.005.247-1.863.743-2.577.495-.71 1.17-1.25 2.04-1.615.796-.335 1.756-.575 2.912-.72.39-.046 1.033-.103 1.92-.174v-.37c0-.93-.105-1.558-.3-1.875-.302-.43-.78-.65-1.44-.65h-.182c-.48.046-.896.196-1.246.46-.35.27-.575.63-.675 1.096-.06.3-.206.465-.435.51l-2.52-.315c-.248-.06-.372-.18-.372-.39 0-.046.007-.09.022-.15.247-1.29.855-2.25 1.82-2.88.976-.616 2.1-.975 3.39-1.05h.54c1.65 0 2.957.434 3.888 1.29.135.15.27.3.405.48.12.165.224.314.283.45.075.134.15.33.195.57.06.254.105.42.135.51.03.104.062.3.076.615.01.313.02.493.02.553v5.28c0 .376.06.72.165 1.036.105.313.21.54.315.674l.51.674c.09.136.136.256.136.36 0 .12-.06.226-.18.314-1.2 1.05-1.86 1.62-1.963 1.71-.165.135-.375.15-.63.045a6.062 6.062 0 01-.526-.496l-.31-.347a9.391 9.391 0 01-.317-.42l-.3-.435c.81.886 1.603 1.44 2.4 1.665.494.15 1.093.227 1.83.227 1.11 0 2.04-.343 2.76-1.034.72-.69 1.08-1.665 1.08-2.94l-.05-.076zm3.753-.438c0 .566.14 1.02.425 1.364.285.34.675.512 1.155.512.045 0 .106-.007.195-.02.09-.016.134-.023.166-.023.614-.16 1.08-.553 1.424-1.178.165-.28.285-.58.36-.91.09-.32.12-.59.135-.8.015-.195.015-.54.015-1.005v-.54c-.84 0-1.484.06-1.92.18-1.275.36-1.92 1.17-1.92 2.43l-.035-.02zm9.162 7.027c.03-.06.075-.11.132-.17.362-.243.714-.41 1.05-.5a8.094 8.094 0 011.612-.24c.14-.012.28 0 .41.03.65.06 1.05.168 1.172.33.063.09.099.228.099.39v.15c0 .51-.149 1.11-.424 1.8-.278.69-.664 1.248-1.156 1.68-.073.06-.14.09-.197.09-.03 0-.06 0-.09-.012-.09-.044-.107-.12-.064-.24.54-1.26.806-2.143.806-2.64 0-.15-.03-.27-.087-.344-.145-.166-.55-.257-1.224-.257-.243 0-.533.016-.87.046-.363.045-.7.09-1 .135-.09 0-.148-.014-.18-.044-.03-.03-.036-.047-.02-.077 0-.017.006-.03.02-.063v-.06z"/></svg>
              </a>
              <a href="https://www.deezer.com/en/artist/djexcept4" target="_blank" rel="noopener" class="platform-logo" aria-label="Deezer">
                <svg viewBox="0 0 24 24" width="56" height="56" fill="currentColor"><path d="M18.81 4.16v3.03H24V4.16h-5.19zM6.27 8.38v3.027h5.189V8.38h-5.19zm12.54 0v3.027H24V8.38h-5.19zM6.27 12.594v3.027h5.189v-3.027h-5.19zm6.271 0v3.027h5.19v-3.027h-5.19zm6.27 0v3.027H24v-3.027h-5.19zM0 16.81v3.029h5.19v-3.03H0zm6.27 0v3.029h5.189v-3.03h-5.19zm6.271 0v3.029h5.19v-3.03h-5.19zm6.27 0v3.029H24v-3.03h-5.19Z"/></svg>
              </a>
              <a href="https://www.tiktok.com/@djexcept4" target="_blank" rel="noopener" class="platform-logo" aria-label="TikTok">
                <svg viewBox="0 0 24 24" width="56" height="56" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
              </a>
            </div>
    </div>
  </section>

  <!-- ── Social Links ── -->
  <section class="section section-sm" aria-labelledby="social-heading">
    <div class="container">
      <h2 id="social-heading" class="section-title">{isEn ? 'Follow Me' : 'Folge mir'}</h2>
      <div class="social-links">
        {socialLinks.instagram && (
          <a href={socialLinks.instagram.url} target="_blank" rel="noopener" class="social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.5"/></svg>
            <span>{isEn ? 'Instagram' : 'Instagram'}</span>
          </a>
        )}
        {socialLinks.youtube && (
          <a href={socialLinks.youtube.url} target="_blank" rel="noopener" class="social-link" aria-label="YouTube">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            <span>{isEn ? 'YouTube' : 'YouTube'}</span>
          </a>
        )}
        {socialLinks.distrokid && (
          <a href={socialLinks.distrokid.url} target="_blank" rel="noopener" class="social-link" aria-label="DistroKid">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            <span>{isEn ? 'DistroKid' : 'DistroKid'}</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  {faqs.length > 0 && (
    <section class="section" aria-labelledby="faq-heading">
      <div class="container">
        <h2 id="faq-heading" class="section-title">{isEn ? 'FAQ' : 'Häufig gestellte Fragen'}</h2>
        <dl class="faq-list">
          {faqs.map((faq) => (
            <div class="faq-item card">
              <dt>{faq.question}</dt>
              <dd>{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--dj-bg-primary) 0%, var(--dj-bg-secondary) 50%, var(--dj-surface) 100%);
    overflow: hidden;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 50%, rgba(77, 201, 246, 0.08) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 50%, rgba(244, 114, 182, 0.06) 0%, transparent 60%);
  }
  .hero-logo-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.06;
    pointer-events: none;
    z-index: 0;
  }
  .hero-logo-bg img {
    width: 600px;
    height: 600px;
    object-fit: contain;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-block: var(--space-24);
  }
  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--dj-text-muted);
    margin-top: var(--space-4);
    max-width: 60ch;
    margin-inline: auto;
  }
  .hero-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }

  /* ── Section header ── */
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .section-title {
    margin-bottom: var(--space-6);
  }

  /* ── Track hero card ── */
  .track-hero-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 768px) {
    .track-hero-card {
      grid-template-columns: 1fr 1fr;
    }
  }
  .track-hero-cover {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--dj-surface);
  }
  .track-hero-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .track-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--dur-base);
  }
  .track-hero-cover:hover .track-hero-overlay {
    opacity: 1;
  }
  .play-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background: var(--dj-accent);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-glow);
    transition: transform var(--dur-base);
  }
  .play-button:hover { transform: scale(1.1); }

  .track-hero-info h3 {
    margin-bottom: var(--space-2);
  }
  .track-meta {
    font-size: 0.875rem;
    color: var(--dj-text-muted);
    margin-bottom: var(--space-3);
  }
  .track-description {
    margin-bottom: var(--space-4);
  }
  .track-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* ── YouTube grid ── */
  .youtube-grid {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .youtube-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .youtube-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .youtube-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 0;
    overflow: hidden;
  }
  .youtube-thumb {
    position: relative;
    aspect-ratio: 16/9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--dj-surface);
  }
  .youtube-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow);
  }
  .youtube-card:hover .youtube-thumb img {
    transform: scale(1.05);
  }
  .youtube-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    opacity: 0;
    transition: opacity var(--dur-base);
  }
  .youtube-card:hover .youtube-play {
    opacity: 1;
  }
  .youtube-card-info h3 {
    font-size: 1rem;
    margin-bottom: var(--space-1);
  }

  /* ── Promo card ── */
  .promo-card {
    background: linear-gradient(135deg, var(--dj-surface) 0%, var(--dj-surface-elevated) 100%);
    border: 1px solid var(--dj-accent-dim);
  }
  .promo-content {
    text-align: center;
    max-width: 60ch;
    margin-inline: auto;
  }
  .promo-content h3 {
    margin-bottom: var(--space-3);
  }
  .promo-content p {
    margin-bottom: var(--space-6);
  }

  /* ── Platform logos (uniform design) ── */
  .platform-logos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    justify-content: center;
    align-items: center;
  }
  .platform-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--dj-surface);
    border: 1px solid var(--dj-border-subtle);
    color: var(--dj-text-secondary);
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: all var(--dur-base);
  }
  .platform-logo:hover {
    color: var(--dj-accent);
    border-color: var(--dj-accent);
    box-shadow: var(--shadow-glow);
    transform: translateY(-2px);
  }
  .platform-logo-letter {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Social links ── */
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
  }
  .social-link {
    display: flex;
    align-items: center;
