---
import Layout from '../../layouts/Layout.astro';
import content from '../../data/content.json';

const locale = Astro.currentLocale || 'de';
const isEn = locale === 'en';
const basePath = isEn ? 'en/' : 'de/';
const tracks = content.tracks || [];
const latestTrack = tracks[0];
const socialLinks = content.social || {};
const ads = content.ads || [];
const faqs = content.faq || [];
const youtube = content.youtube || {};
---

<Layout
  title={isEn ? 'DJ Except4 — Electronic Music Producer' : 'DJ Except4 — Electronic Music Producer'}
  description={isEn ? 'DJ & Producer from Germany. Uplifting Trance, Vocal Trance and Emotional Electronic Music. Listen, follow, and stay connected.' : 'DJ & Producer aus Deutschland. Uplifting Trance, Vocal Trance und emotionales Electronic Music. Hören, folgen und vernetzen.'}
  image={`/assets/DJ_Except4-Logo-1200.webp`}
  type="website"
  locale={locale}
>

  <!-- ── Hero ── -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-overlay"></div>
    <div class="hero-content container">
      <p class="eyebrow">{isEn ? 'Welcome to my world' : 'Willkommen in meiner Welt'}</p>
      <h1 id="hero-heading">
        {isEn ? 'DJ Except4' : 'DJ Except4'}
      </h1>
      <p class="hero-subtitle">
        {isEn
          ? 'Uplifting Trance · Vocal Trance · Emotional Electronic Music'
          : 'Uplifting Trance · Vocal Trance · Emotionales Electronic Music'}
      </p>
      <div class="hero-actions">
        <a href={`/${basePath}tracks/`} class="btn btn-primary">
          {isEn ? 'Listen to Music' : 'Musik hören'}
        </a>
        <a href={`/${basePath}contact/`} class="btn btn-secondary">
          {isEn ? 'Get in Touch' : 'Kontakt aufnehmen'}
        </a>
      </div>
    </div>
  </section>

  <!-- ── Latest Track ── -->
  {latestTrack && (
    <section class="section" aria-labelledby="latest-heading">
      <div class="container">
        <div class="section-header">
          <h2 id="latest-heading">{isEn ? 'Latest Release' : 'Neueste Veröffentlichung'}</h2>
          <a href={`/${basePath}tracks/`} class="btn btn-ghost">
            {isEn ? 'All Tracks →' : 'Alle Tracks →'}
          </a>
        </div>
        <div class="track-hero-card card">
          <div class="track-hero-cover">
            <img
              src={latestTrack.files?.cover || '/assets/DJ_Except4-Logo-1200.webp'}
              alt={`${latestTrack.title} Cover`}
              width="400"
              height="400"
              loading="eager"
            />
            <div class="track-hero-overlay">
              <a href={latestTrack.files?.mp4 || latestTrack.youtube?.url || '#'} class="play-button" aria-label={isEn ? 'Play' : 'Abspielen'}>
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <circle cx="24" cy="24" r="23" stroke="white" stroke-width="2" fill="none"/>
                  <path d="M19 16L34 24L19 32V16Z" fill="white"/>
                </svg>
              </a>
            </div>
          </div>
          <div class="track-hero-info">
            <p class="eyebrow">{latestTrack.title}</p>
            <h3>{latestTrack.title}</h3>
            <p class="track-meta">
              {latestTrack.bpm} BPM · {latestTrack.key} · {latestTrack.releaseDate || ''}
            </p>
            <p class="track-description">{latestTrack.description}</p>
            <div class="track-actions">
              {latestTrack.files?.mp3 && (
                <a href={latestTrack.files.mp3} class="btn btn-primary" download>
                  {isEn ? 'Download MP3' : 'MP3 herunterladen'}
                </a>
              )}
              {latestTrack.youtube?.url && (
                <a href={latestTrack.youtube.url} class="btn btn-secondary" target="_blank" rel="noopener">
                  {isEn ? 'Watch on YouTube' : 'Auf YouTube ansehen'}
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ── YouTube Showcase ── -->
  <section class="section section-sm" aria-labelledby="youtube-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="youtube-heading">{isEn ? 'YouTube' : 'YouTube'}</h2>
        <a href="https://www.youtube.com/@DJExcept4" target="_blank" rel="noopener" class="btn btn-ghost">
          {isEn ? 'Subscribe →' : 'Abonnieren →'}
        </a>
      </div>
      <div class="grid-cards youtube-grid">
        {tracks.slice(0, 3).map((track) => (
          <a href={track.youtube?.url || '#'} target="_blank" rel="noopener" class="youtube-card card">
            <div class="youtube-thumb">
              <img
                src={track.files?.cover || '/media/youtube/thumb-' + track.id + '-maxres.jpg'}
                alt={track.title + ' YouTube thumbnail'}
                width="400"
                height="225"
                loading="lazy"
              />
              <div class="youtube-play">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                  <circle cx="20" cy="20" r="19" fill="rgba(0,0,0,0.6)" stroke="white" stroke-width="2"/>
                  <path d="M15 14L28 20L15 26V14Z" fill="white"/>
                </svg>
              </div>
            </div>
            <div class="youtube-card-info">
              <h3>{track.title}</h3>
              <p class="track-meta">{track.bpm} BPM · {track.key}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── DistroKid Promotion ── -->
  {ads.length > 0 && ads[0] && (
    <section class="section section-sm" aria-labelledby="ad-heading">
      <div class="container">
        <div class="promo-card card">
          <div class="promo-content">
            <h3>{ads[0].title}</h3>
            <p>{ads[0].description}</p>
            <a href={ads[0].url} class="btn btn-primary" target="_blank" rel="noopener">
              {isEn ? 'Learn More' : 'Mehr erfahren'}
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ── Music Platforms ── -->
  <section class="section section-sm" aria-labelledby="platforms-heading">
    <div class="container">
      <h2 id="platforms-heading" class="section-title">{isEn ? 'Available on' : 'Verfügbar auf'}</h2>
      <div class="platform-logos">
              <a href="https://open.spotify.com/artist/djexcept4" target="_blank" rel="noopener" class="platform-logo" aria-label="Spotify">
                <span class="platform-logo-letter">S</span>
              </a>
              <a href="https://music.apple.com/artist/djexcept4" target="_blank" rel="noopener" class="platform-logo" aria-label="Apple Music">
                <span class="platform-logo-letter">A</span>
              </a>
              <a href="https://music.youtube.com/channel/UC74F7b6EKNZczMq-saELxWQ" target="_blank" rel="noopener" class="platform-logo" aria-label="YouTube Music">
                <span class="platform-logo-letter">Y</span>
              </a>
              <a href="https://www.amazon.com/music/player/artists/djexcept4" target="_blank" rel="noopener" class="platform-logo" aria-label="Amazon Music">
                <span class="platform-logo-letter">Am</span>
              </a>
              <a href="https://www.deezer.com/en/artist/djexcept4" target="_blank" rel="noopener" class="platform-logo" aria-label="Deezer">
                <span class="platform-logo-letter">D</span>
              </a>
              <a href="https://www.tiktok.com/@djexcept4" target="_blank" rel="noopener" class="platform-logo" aria-label="TikTok">
                <span class="platform-logo-letter">T</span>
              </a>
            </div>
    </div>
  </section>

  <!-- ── Social Links ── -->
  <section class="section section-sm" aria-labelledby="social-heading">
    <div class="container">
      <h2 id="social-heading" class="section-title">{isEn ? 'Follow Me' : 'Folge mir'}</h2>
      <div class="social-links">
        {socialLinks.instagram && (
          <a href={socialLinks.instagram.url} target="_blank" rel="noopener" class="social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.5"/></svg>
            <span>{isEn ? 'Instagram' : 'Instagram'}</span>
          </a>
        )}
        {socialLinks.youtube && (
          <a href={socialLinks.youtube.url} target="_blank" rel="noopener" class="social-link" aria-label="YouTube">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            <span>{isEn ? 'YouTube' : 'YouTube'}</span>
          </a>
        )}
        {socialLinks.distrokid && (
          <a href={socialLinks.distrokid.url} target="_blank" rel="noopener" class="social-link" aria-label="DistroKid">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            <span>{isEn ? 'DistroKid' : 'DistroKid'}</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  {faqs.length > 0 && (
    <section class="section" aria-labelledby="faq-heading">
      <div class="container">
        <h2 id="faq-heading" class="section-title">{isEn ? 'FAQ' : 'Häufig gestellte Fragen'}</h2>
        <dl class="faq-list">
          {faqs.map((faq) => (
            <div class="faq-item card">
              <dt>{faq.question}</dt>
              <dd>{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--dj-bg-primary) 0%, var(--dj-bg-secondary) 50%, var(--dj-surface) 100%);
    overflow: hidden;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 50%, rgba(77, 201, 246, 0.08) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 50%, rgba(244, 114, 182, 0.06) 0%, transparent 60%);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-block: var(--space-24);
  }
  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--dj-text-muted);
    margin-top: var(--space-4);
    max-width: 60ch;
    margin-inline: auto;
  }
  .hero-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }

  /* ── Section header ── */
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .section-title {
    margin-bottom: var(--space-6);
  }

  /* ── Track hero card ── */
  .track-hero-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 768px) {
    .track-hero-card {
      grid-template-columns: 1fr 1fr;
    }
  }
  .track-hero-cover {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--dj-surface);
  }
  .track-hero-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .track-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--dur-base);
  }
  .track-hero-cover:hover .track-hero-overlay {
    opacity: 1;
  }
  .play-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background: var(--dj-accent);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-glow);
    transition: transform var(--dur-base);
  }
  .play-button:hover { transform: scale(1.1); }

  .track-hero-info h3 {
    margin-bottom: var(--space-2);
  }
  .track-meta {
    font-size: 0.875rem;
    color: var(--dj-text-muted);
    margin-bottom: var(--space-3);
  }
  .track-description {
    margin-bottom: var(--space-4);
  }
  .track-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* ── YouTube grid ── */
  .youtube-grid {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .youtube-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .youtube-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .youtube-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 0;
    overflow: hidden;
  }
  .youtube-thumb {
    position: relative;
    aspect-ratio: 16/9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--dj-surface);
  }
  .youtube-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow);
  }
  .youtube-card:hover .youtube-thumb img {
    transform: scale(1.05);
  }
  .youtube-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    opacity: 0;
    transition: opacity var(--dur-base);
  }
  .youtube-card:hover .youtube-play {
    opacity: 1;
  }
  .youtube-card-info h3 {
    font-size: 1rem;
    margin-bottom: var(--space-1);
  }

  /* ── Promo card ── */
  .promo-card {
    background: linear-gradient(135deg, var(--dj-surface) 0%, var(--dj-surface-elevated) 100%);
    border: 1px solid var(--dj-accent-dim);
  }
  .promo-content {
    text-align: center;
    max-width: 60ch;
    margin-inline: auto;
  }
  .promo-content h3 {
    margin-bottom: var(--space-3);
  }
  .promo-content p {
    margin-bottom: var(--space-6);
  }

  /* ── Platform logos (uniform design) ── */
  .platform-logos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
    align-items: center;
  }
  .platform-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--dj-surface);
    border: 1px solid var(--dj-border-subtle);
    color: var(--dj-text-secondary);
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: all var(--dur-base);
  }
  .platform-logo:hover {
    color: var(--dj-accent);
    border-color: var(--dj-accent);
    box-shadow: var(--shadow-glow);
    transform: translateY(-2px);
  }
  .platform-logo-letter {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Social links ── */
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
  }
  .social-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--dj-surface);
    border: 1px solid var(--dj-border-subtle);
    border-radius: var(--radius-full);
    color: var(--dj-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all var(--dur-base);
  }
  .social-link:hover {
    color: var(--dj-text-primary);
    border-color: var(--dj-accent);
    background: var(--dj-surface-elevated);
  }

  /* ── FAQ ── */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .faq-item {
    padding: var(--space-5) var(--space-6);
  }
  .faq-item dt {
    font-weight: 700;
    margin-bottom: var(--space-2);
    color: var(--dj-text-primary);
  }
  .faq-item dd {
    color: var(--dj-text-secondary);
    line-height: 1.7;
  }
</style>