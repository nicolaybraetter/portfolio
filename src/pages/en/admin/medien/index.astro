---
import Layout from '../../../../layouts/AdminLayout.astro';
import content from '../../../../data/content.json';

const locale = Astro.currentLocale || 'de';
const isEn = locale === 'en';
---

<Layout title={isEn ? 'Admin — Media' : 'Admin — Medien'}>
  <section class="section" aria-labelledby="admin-heading">
    <div class="container">
      <h1 id="admin-heading">{isEn ? 'Media Library' : 'Mediathek'}</h1>

      <div class="admin-section">
        <div class="media-toolbar">
      <button class="btn btn-primary" id="btn-upload">
        {isEn ? '+ Upload Media' : '+ Medien hochladen'}
      </button>
      <input type="file" id="media-upload" multiple accept="image/*" class="hidden" />
    </div>

    <div class="media-grid" id="media-grid">
      <p class="media-empty">{isEn ? 'No media files uploaded yet.' : 'Noch keine Mediendateien hochgeladen.'}</p>
    </div>
  </div>

  <!-- Upload Modal -->
  <div class="upload-modal" id="upload-modal" class="hidden">
    <div class="modal-content">
      <h3>{isEn ? 'Upload Media' : 'Medien hochladen'}</h3>
      <p>{isEn ? 'Drag & drop files or click to select' : 'Dateien per Drag & Drop ablegen oder klicken zum Auswählen'}</p>
      <input type="file" id="file-input" multiple accept="image/png,image/jpeg,image/webp,image/svg" />
      <div class="upload-preview" id="upload-preview"></div>
      <div class="form-actions">
        <button type="button" class="btn btn-primary" id="btn-do-upload">
          {isEn ? 'Upload' : 'Hochladen'}
        </button>
        <button type="button" class="btn btn-secondary" id="btn-cancel-upload">
          {isEn ? 'Cancel' : 'Abbrechen'}
        </button>
      </div>
    </div>
  </div>

  <!-- Edit Modal -->
  <div class="upload-modal" id="edit-modal" class="hidden">
    <div class="modal-content">
      <h3 id="edit-modal-title">{isEn ? 'Edit Media' : 'Medien bearbeiten'}</h3>
      <input type="hidden" id="edit-media-id" value="" />
      <div class="form-group">
        <label for="edit-media-title">{isEn ? 'Title' : 'Titel'}</label>
        <input type="text" id="edit-media-title" />
      </div>
      <div class="form-group">
        <label for="edit-media-alt">{isEn ? 'Alt Text' : 'Alt-Text'}</label>
        <input type="text" id="edit-media-alt" />
      </div>
      <div class="form-actions">
        <button type="button" class="btn btn-primary" id="btn-save-edit">
          {isEn ? 'Save' : 'Speichern'}
        </button>
        <button type="button" class="btn btn-secondary" id="btn-cancel-edit">
          {isEn ? 'Cancel' : 'Abbrechen'}
        </button>
      </div>
    </div>
  </div>
    </div>
  </section>
</Layout>

<script define:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const isEn = document.documentElement.lang === 'en';
    const btnUpload = document.getElementById('btn-upload');
    const fileInput = document.getElementById('file-input');
    const uploadModal = document.getElementById('upload-modal');
    const btnCancelUpload = document.getElementById('btn-cancel-upload');
    const btnDoUpload = document.getElementById('btn-do-upload');
    const preview = document.getElementById('upload-preview');
    const grid = document.getElementById('media-grid');

    const editModal = document.getElementById('edit-modal');
    const editTitle = document.getElementById('edit-modal-title');
    const editId = document.getElementById('edit-media-id');
    const editMediaTitle = document.getElementById('edit-media-title');
    const editMediaAlt = document.getElementById('edit-media-alt');
    const btnSaveEdit = document.getElementById('btn-save-edit');
    const btnCancelEdit = document.getElementById('btn-cancel-edit');

    // Upload modal
    if (btnUpload && uploadModal) {
      btnUpload.addEventListener('click', () => {
        uploadModal.classList.remove('hidden');
        uploadModal.style.display = 'flex';
      });
    }

    if (btnCancelUpload && uploadModal) {
      btnCancelUpload.addEventListener('click', () => {
        uploadModal.classList.add('hidden');
        uploadModal.style.display = 'none';
      });
    }

    // Preview selected files
    if (fileInput && preview) {
      fileInput.addEventListener('change', () => {
        preview.innerHTML = '';
        Array.from(fileInput.files).forEach((file) => {
          const div = document.createElement('div');
          div.className = 'upload-item';
          div.textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
          preview.appendChild(div);
        });
      });
    }

    // Simulate upload
    if (btnDoUpload && uploadModal && grid) {
      btnDoUpload.addEventListener('click', () => {
        alert(isEn ? 'Upload functionality requires a backend. Files would be stored in /public/media/' : 'Upload-Funktion erfordert ein Backend. Dateien würden in /public/media/ gespeichert.');
        uploadModal.classList.add('hidden');
        uploadModal.style.display = 'none';
      });
    }

    // Edit modal
    if (btnSaveEdit && editModal) {
      btnSaveEdit.addEventListener('click', () => {
        const id = editId ? editId.value : '';
        const title = editMediaTitle ? editMediaTitle.value : '';
        const alt = editMediaAlt ? editMediaAlt.value : '';

        // Update the media card in the grid
        const card = document.querySelector('.media-card[data-id="' + id + '"]');
        if (card) {
          const titleEl = card.querySelector('.media-card-title');
          const altEl = card.querySelector('.media-card-alt');
          if (titleEl) titleEl.textContent = title;
          if (altEl) altEl.textContent = alt;
        }

        editModal.classList.add('hidden');
        editModal.style.display = 'none';
      });
    }

    if (btnCancelEdit && editModal) {
      btnCancelEdit.addEventListener('click', () => {
        editModal.classList.add('hidden');
        editModal.style.display = 'none';
      });
    }

    // Edit media — open edit modal with card data
    document.querySelectorAll('.btn-edit-media').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        const card = document.querySelector('.media-card[data-id="' + id + '"]');
        if (!card || !editModal) return;

        const title = card.querySelector('.media-card-title') ? card.querySelector('.media-card-title').textContent : '';
        const alt = card.querySelector('.media-card-alt') ? card.querySelector('.media-card-alt').textContent : '';

        if (editId) editId.value = id;
        if (editMediaTitle) editMediaTitle.value = title;
        if (editMediaAlt) editMediaAlt.value = alt;
        if (editTitle) editTitle.textContent = isEn ? 'Edit Media' : 'Medien bearbeiten';

        editModal.classList.remove('hidden');
        editModal.style.display = 'flex';
      });
    });

    // Delete media
    document.querySelectorAll('.btn-delete-media').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        const card = document.querySelector('.media-card[data-id="' + id + '"]');
        if (card && confirm(isEn ? 'Are you sure you want to delete this media file?' : 'Willst du diese Mediendatei wirklich löschen?')) {
          card.remove();
        }
      });
    });
  });
</script>