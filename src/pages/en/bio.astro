---
import Layout from '../../layouts/Layout.astro';
import content from '../../data/content.json';

const locale = Astro.currentLocale || 'de';
const isEn = locale === 'en';
const site = content.site;
---

<Layout
  title={isEn ? 'Bio — DJ Except4' : 'Bio — DJ Except4'}
  description={isEn ? site.bioEn : site.bio}
  image={`/assets/DJ_Except4-Logo-120.webp`}
  type="website"
  locale={locale}
>
  <section class="bio-page" aria-labelledby="bio-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{isEn ? 'About' : 'Über'}</p>
        <h1 id="bio-heading">{isEn ? 'About DJ Except4' : 'Über DJ Except4'}</h1>
      </div>

      <div class="bio-content">
        <p class="bio-lead">DJ Except4 creates emotional, uplifting and cinematic trance music.</p>
        <p>Discover original Vocal Trance, Uplifting Trance, Melodic Trance and Progressive Trance featuring driving basslines, powerful synths, atmospheric breakdowns and euphoric drops.</p>

        <h3>{isEn ? 'On this channel' : 'Auf diesem Kanal'}</h3>
        <ul>
          <li>{isEn ? 'Original trance releases' : 'Original Trance-Releases'}</li>
          <li>{isEn ? 'Official audio and music visualizers' : 'Offizielle Audios und Musik-Visualizer'}</li>
          <li>{isEn ? 'Emotional and cinematic trance' : 'Emotionale und cineastische Trance'}</li>
          <li>{isEn ? 'Vocal, melodic and progressive trance' : 'Vocal, Melodic und Progressive Trance'}</li>
          <li>{isEn ? 'Trance Shorts, previews and DJ mixes' : 'Trance Shorts, Previews und DJ-Mixes'}</li>
        </ul>

        <p class="bio-cta">{isEn ? 'Subscribe and join DJ Except4 on a journey through emotion, energy and electronic music.' : 'Abonniere und begleite DJ Except4 auf einer Reise durch Emotion, Energie und elektronische Musik.'}</p>
        <p>{isEn ? 'New music released regularly.' : 'Neue Musik wird regelmäßig veröffentlicht.'}</p>

        <div class="bio-details">
          <p><strong>{isEn ? 'Artist' : 'Künstler'}:</strong> DJ Except4</p>
          <p><strong>{isEn ? 'Styles' : 'Stile'}:</strong> {isEn ? 'Uplifting Trance / Vocal Trance / Melodic Trance / Progressive Trance / Epic Trance' : 'Uplifting Trance / Vocal Trance / Melodic Trance / Progressive Trance / Epic Trance'}</p>
        </div>

        <p class="bio-thanks">{isEn ? 'Streaming, social media and support links can be found in the channel links.' : 'Streaming-, Social-Media- und Support-Links findest du in den Kanallinks.'}</p>
        <p class="bio-thanks">{isEn ? 'Thank you for listening, sharing and supporting independent trance music.' : 'Danke fürs Zuhören, Teilen und Unterstützen unabhängiger Trance-Musik.'}</p>

        <!-- ── Audio Visualizer ── -->
        <div class="bio-visualizer" aria-hidden="true">
          <div class="viz-bar"></div><div class="viz-bar"></div><div class="viz-bar"></div>
          <div class="viz-bar"></div><div class="viz-bar"></div><div class="viz-bar"></div>
          <div class="viz-bar"></div><div class="viz-bar"></div><div class="viz-bar"></div>
          <div class="viz-bar"></div><div class="viz-bar"></div><div class="viz-bar"></div>
          <div class="viz-bar"></div><div class="viz-bar"></div><div class="viz-bar"></div>
          <div class="viz-bar"></div><div class="viz-bar"></div><div class="viz-bar"></div>
          <div class="viz-bar"></div><div class="viz-bar"></div>
        </div>
      </div>

      <section class="bio-genres" aria-labelledby="genres-heading">
        <h2 id="genres-heading">{isEn ? 'Genres' : 'Genres'}</h2>
        <ul class="genre-list">
          <li>Uplifting Trance</li>
          <li>Vocal Trance</li>
          <li>Emotional Trance</li>
          <li>Melodic Trance</li>
          <li>Atmospheric Trance</li>
          <li>Cinematic Trance</li>
        </ul>
      </section>

      <section class="bio-contact" aria-labelledby="bio-contact-heading">
        <h2 id="bio-contact-heading">{isEn ? 'Get in Touch' : 'Kontakt'}</h2>
        <p>{isEn ? 'For collaborations or inquiries:' : 'Für Kooperationen oder Anfragen:'}</p>
        <a href="mailto:info@djexcept4.de" class="button button-primary">info@djexcept4.de</a>
      </section>
    </div>
  </section>
</Layout>

<style>
  .bio-page {
    padding: clamp(3rem, 7vw, 5rem) 0;
  }

  .bio-content {
    max-width: 720px;
    margin: var(--space-2xl) auto;
  }

  .bio-content p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--dj-text-secondary);
  }

  .bio-lead {
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--dj-text-primary);
    margin-bottom: var(--space-lg);
  }

  .bio-content h3 {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    font-size: 1.1rem;
    color: var(--dj-text-primary);
  }

  .bio-content ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-xl) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .bio-content li {
    position: relative;
    padding-left: var(--space-xl);
    color: var(--dj-text-secondary);
    line-height: 1.6;
  }

  .bio-content li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--dj-accent);
  }

  .bio-cta {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--dj-text-primary);
    margin-bottom: var(--space-md);
  }

  .bio-details {
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background: var(--dj-surface);
    border: 1px solid var(--dj-border);
    border-radius: var(--radius-lg);
  }

  .bio-details p {
    margin: 0 0 var(--space-sm) 0;
    font-size: 0.95rem;
    color: var(--dj-text-secondary);
  }

  .bio-details p:last-child {
    margin-bottom: 0;
  }

  .bio-thanks {
    margin-top: var(--space-xl);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--dj-text-muted);
    font-style: italic;
  }

  .bio-thanks:last-child {
    margin-bottom: 0;
  }

  .bio-genres,
  .bio-contact {
    margin-top: var(--space-3xl);
  }

  .genre-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
  }

  .genre-list li {
    padding: 0.3rem 0.8rem;
    background: var(--dj-surface);
    border: 1px solid var(--dj-border);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    color: var(--dj-text-primary);
    transition: all var(--dur-base) var(--ease-out);
  }

  .genre-list li:hover {
    border-color: var(--dj-accent);
    box-shadow: 0 0 12px rgba(77, 201, 246, 0.2);
    color: var(--dj-accent);
  }

  .bio-contact p {
    color: var(--dj-text-secondary);
    margin-bottom: var(--space-md);
  }

  .section-heading {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }
</style>